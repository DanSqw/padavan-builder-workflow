# ==============================================================================
# ALT13 Strategy for Zapret (Discord, YouTube, General DPI Desync)
# Based on Flowseal zapret-discord-youtube (ALT13.bat)
# ==============================================================================

# Profile 1: UDP 443 (QUIC) for General List
--filter-udp=443
--hostlist=/usr/share/zapret/list-general.txt
--hostlist=/etc/storage/zapret/user.list
--hostlist-exclude=/usr/share/zapret/list-exclude.txt
--hostlist-exclude=/etc/storage/zapret/exclude.list
--dpi-desync=fake
--dpi-desync-repeats=11
--dpi-desync-fake-quic=/usr/share/zapret/fake/quic_initial_www_google_com.bin

# Profile 2: UDP Discord Voice (WebRTC RTC & STUN)
--new
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--dpi-desync=fake
--dpi-desync-fake-discord=/usr/share/zapret/fake/ACTIVE_DISCORD_UDP.bin
--dpi-desync-fake-stun=/usr/share/zapret/fake/ACTIVE_DISCORD_UDP.bin
--dpi-desync-repeats=5

# Profile 3: TCP Discord Media
--new
--filter-tcp=2053,2083,2087,2096,8443
--hostlist-domains=discord.media
--dpi-desync=fake,multisplit
--dpi-desync-split-seqovl=681
--dpi-desync-split-pos=1
--dpi-desync-fooling=ts
--dpi-desync-repeats=7
--dpi-desync-split-seqovl-pattern=/usr/share/zapret/fake/tls_clienthello_www_google_com.bin
--dpi-desync-fake-tls=/usr/share/zapret/fake/tls_clienthello_www_google_com.bin

# Profile 4: TCP 443 Google & YouTube (hostfakesplit www.google.com)
--new
--filter-tcp=443
--hostlist=/usr/share/zapret/list-google.txt
--dpi-desync=hostfakesplit
--dpi-desync-fooling=ts
--dpi-desync-hostfakesplit-mod=host=www.google.com

# Profile 5: TCP 80,443 General List (hostfakesplit mail.ru)
--new
--filter-tcp=80,443
--hostlist=/usr/share/zapret/list-general.txt
--hostlist=/etc/storage/zapret/user.list
--hostlist-exclude=/usr/share/zapret/list-exclude.txt
--hostlist-exclude=/etc/storage/zapret/exclude.list
--dpi-desync=fake,hostfakesplit
--dpi-desync-fooling=ts
--dpi-desync-hostfakesplit-mod=host=mail.ru,altorder=1
--dpi-desync-repeats=5
--dpi-desync-fake-tls=/usr/share/zapret/fake/tls_clienthello_sochi_park.bin
--dpi-desync-fake-tls=/usr/share/zapret/fake/stun2.bin
--dpi-desync-fake-http=/usr/share/zapret/fake/tls_clienthello_sochi_park.bin

# Profile 6: UDP 443 IPSet (if enabled)
--new
--filter-udp=443
--ipset=/usr/share/zapret/ipset-all.txt.gz
--hostlist-exclude=/usr/share/zapret/list-exclude.txt
--hostlist-exclude=/etc/storage/zapret/exclude.list
--dpi-desync=fake
--dpi-desync-repeats=11
--dpi-desync-fake-quic=/usr/share/zapret/fake/quic_initial_www_google_com.bin

# Profile 7: TCP 80,443,8443 IPSet (if enabled)
--new
--filter-tcp=80,443,8443
--ipset=/usr/share/zapret/ipset-all.txt.gz
--hostlist-exclude=/usr/share/zapret/list-exclude.txt
--hostlist-exclude=/etc/storage/zapret/exclude.list
--dpi-desync=fake,hostfakesplit
--dpi-desync-fooling=ts
--dpi-desync-hostfakesplit-mod=host=mail.ru,altorder=1
--dpi-desync-repeats=5
--dpi-desync-fake-tls=/usr/share/zapret/fake/tls_clienthello_sochi_park.bin
--dpi-desync-fake-tls=/usr/share/zapret/fake/stun2.bin
--dpi-desync-fake-http=/usr/share/zapret/fake/tls_clienthello_sochi_park.bin

# Profile 8: TCP Game Filter
--new
--filter-tcp=12
--ipset=/usr/share/zapret/ipset-all.txt.gz
--dpi-desync=fake,hostfakesplit
--dpi-desync-any-protocol=1
--dpi-desync-cutoff=n4
--dpi-desync-fooling=ts
--dpi-desync-hostfakesplit-mod=host=mail.ru,altorder=1
--dpi-desync-repeats=5
--dpi-desync-fake-tls=/usr/share/zapret/fake/tls_clienthello_sochi_park.bin
--dpi-desync-fake-tls=/usr/share/zapret/fake/stun2.bin
--dpi-desync-fake-http=/usr/share/zapret/fake/tls_clienthello_sochi_park.bin
--dpi-desync-fake-unknown=/usr/share/zapret/fake/tls_clienthello_sochi_park.bin
--dpi-desync-fake-unknown=/usr/share/zapret/fake/stun2.bin

# Profile 9: UDP Game Filter
--new
--filter-udp=12
--ipset=/usr/share/zapret/ipset-all.txt.gz
--dpi-desync=fake
--dpi-desync-repeats=10
--dpi-desync-any-protocol=1
--dpi-desync-fake-unknown-udp=/usr/share/zapret/fake/ACTIVE_GAME_UDP.bin
--dpi-desync-cutoff=n4
