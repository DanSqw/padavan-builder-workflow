# Profile 1: Discord WebRTC UDP Voice
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--dpi-desync=fake
--dpi-desync-fake-discord=/usr/share/zapret/fake/ACTIVE_DISCORD_UDP.bin
--dpi-desync-fake-stun=/usr/share/zapret/fake/ACTIVE_DISCORD_UDP.bin
--dpi-desync-repeats=6

# Profile 2: QUIC UDP 443
--new
--filter-udp=443
--dpi-desync=fake
--dpi-desync-repeats=6
--dpi-desync-fake-quic=/usr/share/zapret/fake/quic_initial_www_google_com.bin
--hostlist-exclude=/usr/share/zapret/list-exclude.txt
--hostlist-exclude=/etc/storage/zapret/exclude.list

# Profile 3: TCP Discord Media (Cloudflare non-standard ports)
--new
--filter-tcp=2053,2083,2087,2096,8443
--hostlist-domains=discord.media
--dpi-desync=fake,multisplit
--dpi-desync-split-pos=1,midsld
--dpi-desync-fooling=badseq
--dpi-desync-badseq-increment=10000000
--dpi-desync-repeats=6
--dpi-desync-fake-tls=/usr/share/zapret/fake/tls_clienthello_www_google_com.bin

# Profile 4: HTTP 80 (Safe Plaintext Redirection, no 400 Bad Request)
--new
--filter-tcp=80
--dpi-desync=fakeddisorder
--dpi-desync-split-pos=sld+1
--dpi-desync-fooling=md5sig
--dpi-desync-split-seqovl=1
--dpi-desync-split-seqovl-pattern=0x0168d3a1e8ce99f6
--hostlist-exclude=/usr/share/zapret/list-exclude.txt
--hostlist-exclude=/etc/storage/zapret/exclude.list

# Profile 5: HTTPS 443 Main (Google, YouTube, Discord, General Blocked Sites)
--new
--filter-tcp=443
--dpi-desync=fake,fakedsplit
--dpi-desync-split-pos=1,midsld
--dpi-desync-fooling=badseq
--dpi-desync-badseq-increment=10000000
--dpi-desync-split-seqovl=2
--dpi-desync-split-seqovl-pattern=0x01d400faf69a3bcb
--dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com
--dpi-desync-fake-tls=/usr/share/zapret/fake/tls_clienthello_www_google_com.bin
--hostlist-exclude=/usr/share/zapret/list-exclude.txt
--hostlist-exclude=/etc/storage/zapret/exclude.list

# Profile 6: IPSet Fallback TCP (for IP-blocked resources)
--new
--filter-tcp=443,8443
--ipset=/usr/share/zapret/ipset-all.txt.gz
--dpi-desync=fake,fakedsplit
--dpi-desync-split-pos=1,midsld
--dpi-desync-fooling=badseq
--dpi-desync-badseq-increment=10000000
--hostlist-exclude=/usr/share/zapret/list-exclude.txt
--hostlist-exclude=/etc/storage/zapret/exclude.list

# Profile 7: Games & Wireguard UDP
--new
--filter-udp=51820,2408,1002,500,1701,4500
--dpi-desync=fake
--filter-l7=wireguard
--dpi-desync-repeats=6
--dpi-desync-fake-wireguard=/usr/share/zapret/fake/quic_initial_www_google_com.bin
